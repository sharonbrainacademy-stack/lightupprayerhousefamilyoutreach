rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['brainstormacademybsa@gmail.com', 'imosesstephen@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin_assistant'])
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['brainstormacademybsa@gmail.com', 'imosesstephen@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /admin_passwords/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /books/{bookId} {
      allow read, write: if true;
    }

    match /sermons/{sermonId} {
      allow read, write: if true;
    }

    match /outreach_projects/{projectId} {
      allow read, write: if true;
    }

    match /story_pictures/{picId} {
      allow read, write: if true;
    }

    match /themes/{themeId} {
      allow read, write: if true;
    }

    match /programs/{programId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /testimonies/{testimonyId} {
      allow read, write: if true;
    }

    match /prayer_requests/{requestId} {
      allow read, write: if true;
    }

    match /whatsapp_joins/{joinId} {
      allow read, write: if true;
    }

    match /zoom_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /zoom_participant_logs/{logId} {
      allow read, write: if true;
    }

    match /guest_attendance/{recordId} {
      allow read, write: if true;
    }

    match /live_meetings/{meetingId} {
      allow read, write: if true;
    }
    
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

